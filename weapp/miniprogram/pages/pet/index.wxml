<view class="page">
  <view class="stage">
    <image class="cat" src="/images/cats/{{pet.active_cat_id}}.png" mode="widthFix" style="transform: scale({{growth.scale}});" />
  </view>

  <view class="bubble" wx:if="{{greeting}}">🐱 {{greeting}}</view>
  <view class="bubble mute" wx:else>它现在还不会说话，完成更多任务陪它长大吧～</view>

  <view class="card">
    <view class="row"><text class="stage-label">{{growth.label}}</text><text class="count">累计完成 {{total}} 次</text></view>
    <view class="pbar" wx:if="{{growth.next}}"><view class="pbar-in" style="width: {{progressPercent}}%;"></view></view>
    <view class="hint" wx:if="{{growth.next}}">距离「下一阶段」还差 {{distanceToNext}} 次</view>
    <view class="hint" wx:else>已经是最大的猫啦 🎉</view>
  </view>

  <view class="sec">猫皮肤</view>
  <view class="skins">
    <view class="skin {{item.id == pet.active_cat_id ? 'sel' : ''}} {{item.unlocked ? '' : 'locked'}}" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}" data-unlocked="{{item.unlocked}}" bindtap="switchCat">
      <image class="skin-img" src="/images/cats/{{item.id}}.png" mode="widthFix" />
      <view class="skin-name">{{item.name}}</view>
      <view class="skin-lock" wx:if="{{!item.unlocked}}">🔒 {{item.threshold}} 次解锁</view>
    </view>
  </view>
</view>
