.page { background: #f6f6f6; min-height: 100vh; padding: 20rpx; box-sizing: border-box; }
.head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.h-title { font-size: 30rpx; font-weight: 700; }
.add { color: #f4511e; font-size: 26rpx; }
.goal { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.goal.archived { opacity: 0.7; }
.g-name { font-size: 28rpx; font-weight: 600; }
.g-meta { display: flex; gap: 16rpx; font-size: 22rpx; color: #999; margin-top: 8rpx; flex-wrap: wrap; }
.pbar { height: 10rpx; background: #f0f0f0; border-radius: 5rpx; margin-top: 16rpx; overflow: hidden; }
.pbar-in { height: 100%; background: #10b981; border-radius: 5rpx; }
.g-actions { display: flex; gap: 24rpx; margin-top: 14rpx; font-size: 24rpx; color: #1890ff; }
.g-actions .danger { color: #f5222d; }
.empty { text-align: center; color: #bbb; padding: 80rpx 0; }
.arch-head { color: #999; font-size: 24rpx; padding: 10rpx 0 20rpx; }
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 100; }
.dialog { width: 84%; max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 20rpx; padding: 32rpx; }
.dialog-title { font-size: 30rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.input { border: 1rpx solid #e5e5e5; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.textarea { border: 1rpx solid #e5e5e5; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; min-height: 120rpx; margin-bottom: 20rpx; }
.picker { color: #333; }
.dialog-footer { display: flex; justify-content: flex-end; gap: 20rpx; }
.btn { background: #f0f0f0; border-radius: 999rpx; font-size: 28rpx; line-height: 72rpx; padding: 0 40rpx; }
.btn::after { border: none; }
.btn.primary { background: #f4511e; color: #fff; }
.detail-sec { font-size: 26rpx; font-weight: 700; margin: 20rpx 0 8rpx; }
.d-row { font-size: 26rpx; color: #555; padding: 8rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.st { font-size: 22rpx; color: #999; }
.st.ok { color: #10b981; }
