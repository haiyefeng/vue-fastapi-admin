# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交。

# ---- 数据库 ----
# 这里填的是**本机**开发用的连接信息：.env 的实际消费者是 `make test`
# （以及直接跑 pytest 时你自己 export 的那份环境），跑的是本机 MySQL。
#
# 注意 docker compose 并不读这三行：docker-compose.yml 的 app 服务把
# DB_HOST / DB_PORT / DB_USER 写成了容器内的字面量（mysql / 3306 / root），
# 编排真正插值的只有 DB_PASSWORD / DB_NAME / WX_APPID / WX_SECRET。
# 所以把 DB_HOST 填成 mysql 不会影响容器，只会让本机测试连不上库。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=改成你的密码
DB_NAME=vue_fastapi_admin

# ---- 微信小程序凭据 ----
# 在微信公众平台 → 你的小程序 → 开发管理 → 开发设置 里获取。
# 后端用它们调 sns/jscode2session，把小程序 wx.login() 拿到的 code 换成 openid。
# AppSecret 必须只存在于服务端：小程序代码包可以被解出来，secret 一旦进客户端，
# 任何人都能冒充你的服务器解析别人的 code。
# 不填的话后端能正常启动，但微信登录会返回 40013 invalid appid。
WX_APPID=
WX_SECRET=
